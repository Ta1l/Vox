APP_DOMAIN=finance.example.com
APP_URL=https://finance.example.com
APP_AUTH_TOKEN=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://finapp:replace-password@postgres:5432/finapp
POSTGRES_USER=finapp
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=finapp
ENCRYPTION_KEY=replace-with-64-hex-characters
BACKUP_PASSPHRASE=replace-with-a-separate-long-secret
NODE_ENV=production
# Run `docker compose -f docker-compose.production.yml up -d` only after replacing every placeholder.
